{
  "_about": "Machine-readable map of the Allen & Heath CQ-12T private protocol (CQ-18T and CQ-20B use the same family, untested). Decoded 8.11.2026 on a CQ-12T by man-in-the-middle with CQ MixPad. Only entries marked verified were seen on the wire AND read back from the desk's connect dump. Full text: PROTOCOL.md.",
  "transport": {
    "discovery": {
      "udp": 51320,
      "request": "CQ Find",
      "answer": "desk name, NUL-terminated"
    },
    "control": {
      "tcp": 51326,
      "one_client_at_a_time": true,
      "handshake": "7F 00 02 00 00 00 <our UDP port LE>",
      "heartbeat": "same frame every 2 s",
      "version": "7F 01",
      "start_stream": "7F 0C 02 00 02 00"
    },
    "stream": {
      "udp_desk_port": 51324,
      "keepalive": "7F 05 every 2.5 s",
      "meters_per_s": 25
    },
    "midi": {
      "tcp": 51325,
      "doc": "Allen & Heath CQ MIDI protocol PDF (faders, sends, pans, mutes, scenes, soft keys)"
    }
  },
  "message": {
    "form": "F7 BB BB PP CH SS VL VH",
    "fields": {
      "BB": "block, written twice",
      "PP": "parameter",
      "CH": "channel",
      "SS": "sub-index (band, destination, FX parameter)",
      "V": "u16 little endian"
    },
    "long_form": "7F 07 <u32 LE length> BB BB PP CH SS ...  (names, colours)"
  },
  "channels": {
    "Ip1-Ip10": "00-09",
    "ST_IN": "18",
    "Out1-Out6": "30-35",
    "Main_LR": "38",
    "FX1_return": "3A",
    "FX2_return": "3B",
    "FX1_to_LR": "20"
  },
  "scales": {
    "db": {
      "formula": "dB = (raw - 0x8000) / 256",
      "used_by": [
        "trim",
        "analogue gain",
        "PEQ gain",
        "faders",
        "sends",
        "AMM weight",
        "headphone level (own offset, unverified)"
      ]
    },
    "freq_hz": {
      "formula": "Hz = 82.5 * 10^((raw - 0x4E9B) / 15316)",
      "status": "two points only (82.5 Hz = 0x4E9B, 277 Hz = 0x6E12); needs calibration"
    },
    "pan": {
      "range": "0x00 left, 0x25 centre, 0x4A right"
    },
    "times": "logarithmic u16, not calibrated",
    "ratio_and_width": "index, not calibrated",
    "krishna_das_target": {
      "what": "two Krishna Das references played into the CQ's USB channel and read on Main LR's own RTA, octave share of the whole (dB) 31..16k",
      "values": [
        -29.0,
        -13.8,
        -6.6,
        -7.5,
        -6.4,
        -6.3,
        -11.8,
        -15.7,
        -21.4,
        -30.8
      ]
    }
  },
  "inputs": {
    "source": {
      "block": "09",
      "param": "0D",
      "bytes": "F7 09 09 0D CH 01|02 00 17",
      "values": {
        "01": "analogue",
        "02": "SD/USB"
      },
      "verified": true
    },
    "analogue_gain": {
      "block": "0A",
      "param": "0C",
      "bytes": "F7 0A 0A 0C CH 01 <dB>",
      "verified": true
    },
    "trim": {
      "block": "0A",
      "param": "0F",
      "bytes": "F7 0A 0A 0F CH 00 <dB>",
      "verified": true
    },
    "polarity": {
      "block": "0A",
      "param": "10",
      "bytes": "F7 0A 0A 10 CH 00 01|00 00",
      "verified": true
    },
    "hpf_in": {
      "block": "0C",
      "param": "0C",
      "bytes": "F7 0C 0C 0C CH 00 01|00 00",
      "verified": true
    },
    "hpf_freq": {
      "block": "0C",
      "param": "0D",
      "bytes": "F7 0C 0C 0D CH 00 <freq>",
      "verified": true
    },
    "gate": {
      "block": "0D",
      "params": {
        "in": "0C",
        "threshold": "0E",
        "depth": "0F",
        "attack": "10",
        "release": "11",
        "hold": "12"
      },
      "verified": true
    },
    "peq": {
      "block": "0F",
      "params": {
        "gain": "0C",
        "freq": "0D",
        "width": "0E",
        "type": "0F",
        "in": "10"
      },
      "sub": "band 0 LF, 1 LM, 2 HM, 3 HF",
      "types": {
        "00": "bell",
        "06": "LF shelf",
        "0B": "LF filter",
        "07": "HF shelf",
        "0A": "HF filter"
      },
      "verified": true
    },
    "comp": {
      "block": "10",
      "params": {
        "in": "0C",
        "rms_peak": "0D",
        "threshold": "0E",
        "ratio": "0F",
        "gain": "10",
        "attack": "11",
        "release": "12",
        "knee": "13"
      },
      "verified": true
    },
    "autogain_on": {
      "block": "33",
      "bytes": "F7 33 33 0C CH 00 01|00 00",
      "verified": true
    },
    "stereo_link": {
      "bytes": "F7 01 01 0D 01|00 F0 00 00",
      "warning": "copies the odd channel onto the even one; unlinking does not undo it",
      "verified": true
    },
    "name": {
      "bytes": "7F 07 0E 00 00 00 23 23 0C 00 CH 00 00 <ASCII, NUL>",
      "verified": true
    },
    "colour": {
      "bytes": "7F 07 0F 00 00 00 23 23 0D 00 CH 00 00 <u32> <u32>",
      "values": {
        "grey": 0,
        "red": 1
      },
      "verified": true
    }
  },
  "mix": {
